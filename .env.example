# ==============================================================================
# Trading Podcast & YouTube Faceless AI Studio - Environment Configuration
# ==============================================================================

# n8n Orchestrator Configuration
N8N_PORT=5678
N8N_HOST=0.0.0.0
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# n8n Admin Credentials
N8N_ADMIN_EMAIL=admin@tradingpodcast.local
N8N_ADMIN_PASSWORD=YourSecurePasswordHere!

# Bridge Service Configuration
BRIDGE_PORT=8010
OUTPUT_DIR=/app/output
NOTEBOOKLM_STORAGE_STATE=/app/storage_state.json

# Google AI Ecosystem (Gemini 2.5 Pro/Flash, Imagen 3, Veo 3, Google Cloud TTS)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_cloud_or_tts_api_key_here

# TradingAgents Financial Intelligence Backend
DEFAULT_LLM_PROVIDER=openai_compatible
DEFAULT_DEEP_THINK_LLM=ag/gemini-3.8-flash-high
DEFAULT_QUICK_THINK_LLM=ag/gemini-3.8-flash-high
TRADINGAGENTS_BACKEND_URL=http://tradingagents-backend:8000
